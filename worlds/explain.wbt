#VRML_SIM R2025a utf8
EXTERNPROTO "../protos/Crazyflie.proto"
WorldInfo {
  basicTimeStep 20
  coordinateSystem "ENU"
  title "Flybrain: controlled visual trials"
}
Viewpoint {
  position -2.7 -1.25 2.5
  orientation 0 0 1 0
  follow "Crazyflie"
  followType "Pan and Tilt Shot"
}
Background { skyColor [ 0.75 0.84 0.93 ] }
DirectionalLight { direction -1 -1 -2 intensity 1 }
Solid {
  translation 0 0 -0.05
  name "tiled floor"
  children [ Shape {
    appearance PBRAppearance {
      baseColorMap ImageTexture { url [ "textures/floor.png" ] }
      textureTransform TextureTransform { scale 8 3 }
      roughness 1
      metalness 0
    }
    geometry Box { size 8 3 0.1 }
  } ]
  boundingObject Box { size 8 3 0.1 }
}
Solid {
  translation 0 1.55 1.1
  name "left wall"
  children [ Shape { appearance DEF WALL PBRAppearance { baseColor 0.86 0.88 0.87 roughness 1 metalness 0 } geometry Box { size 8 0.1 2.2 } } ]
  boundingObject Box { size 8 0.1 2.2 }
}
Solid {
  translation 0 -1.55 1.1
  name "right wall"
  children [ Shape { appearance USE WALL geometry Box { size 8 0.1 2.2 } } ]
  boundingObject Box { size 8 0.1 2.2 }
}
Solid {
  translation 4 0 1.1
  name "end wall"
  children [ Shape { appearance USE WALL geometry Box { size 0.1 3 2.2 } } ]
  boundingObject Box { size 0.1 3 2.2 }
}
Solid {
  translation -4 0 1.1
  name "start wall"
  children [ Shape { appearance USE WALL geometry Box { size 0.1 3 2.2 } } ]
  boundingObject Box { size 0.1 3 2.2 }
}

Solid {
  translation 1.3 0.57 1
  name "left stimulus screen"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.08 0.38 0.62 roughness 1 metalness 0 }
      geometry Box { size 0.06 1.13 1.85 }
    }
    Pose {
      translation -0.036 0 0
      rotation 0 1 0 -1.5707963267948966
      children [ Shape {
        appearance PBRAppearance {
          baseColorMap ImageTexture { url [ "textures/probe.png" ] }
          textureTransform DEF LEFT_PATTERN TextureTransform { scale 2 2 }
          roughness 1
          metalness 0
        }
        geometry Plane { size 1.62 1.01 }
      } ]
    }
  ]
  boundingObject Box { size 0.06 1.13 1.85 }
}

Solid {
  translation 1.3 -0.57 1
  name "right stimulus screen"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.85 0.34 0.12 roughness 1 metalness 0 }
      geometry Box { size 0.06 1.13 1.85 }
    }
    Pose {
      translation -0.036 0 0
      rotation 0 1 0 -1.5707963267948966
      children [ Shape {
        appearance PBRAppearance {
          baseColorMap ImageTexture { url [ "textures/probe.png" ] }
          textureTransform DEF RIGHT_PATTERN TextureTransform { scale 2 2 }
          roughness 1
          metalness 0
        }
        geometry Plane { size 1.62 1.01 }
      } ]
    }
  ]
  boundingObject Box { size 0.06 1.13 1.85 }
}

DEF DRONE Crazyflie {
  translation -0.8 0 0.02
  controller "flybrain_webots"
  supervisor TRUE
  extensionSlot [
    DEF PROBE_CAMERA_POSE Pose {
      children [ Camera { name "probe_camera" fieldOfView 0.87 width 324 height 324 } ]
    }
  ]
}
